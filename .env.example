# =====================================================================
# NIRIKSHAK AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env for local development or set in Render/Vercel
# NEVER commit real credentials or secrets to version control.
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ---------------------------------------------------------------------
# Options: development, production, test
ENVIRONMENT=development

# Port for backend server (in production Render injects PORT automatically)
PORT=8000

# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL / SQLITE)
# ---------------------------------------------------------------------
# Local development default: sqlite:///backend/nirikshak.db
# Production Cloud PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/[DB-NAME]
DATABASE_URL=sqlite:///backend/nirikshak.db

# Seed demo officer and sample complaints in database (true for dev, false for production)
SEED_DEMO_DATA=false

# ---------------------------------------------------------------------
# 3. FIREBASE INFRASTRUCTURE (BACKEND SECRETS & CONFIG)
# ---------------------------------------------------------------------
# Firebase Project ID (required for ID token verification)
FIREBASE_PROJECT_ID=

# Firebase Cloud Storage Bucket name (e.g. your-project.appspot.com or your-project.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# (Optional) Service Account JSON for Admin SDK (paste full single-line JSON string or path)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------
# 4. JWT & AUTHENTICATION (BACKEND)
# ---------------------------------------------------------------------
# Secret key for local JWT signing (fallback when operating in dev/offline mode)
JWT_SECRET_KEY=nirikshak-ai-development-auth-secret-key-change-in-production
JWT_ISSUER=nirikshak-ai-platform
JWT_AUDIENCE=nirikshak-authorized-users
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Authorized officer email domains (comma-separated, lowercase)
OFFICER_EMAIL_DOMAINS=officer.demo,gov.in,legalmetrology.gov.in

# ---------------------------------------------------------------------
# 5. CORS & NETWORKING (BACKEND)
# ---------------------------------------------------------------------
# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nirikshak-ai.vercel.app

# ---------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY (BACKEND)
# ---------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_COMPLAINTS_MAX=30
RATE_LIMIT_COMPLIANCE_MAX=40
RATE_LIMIT_COPILOT_MAX=30

# ---------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (VITE_* EXPOSED TO BROWSER)
# ---------------------------------------------------------------------
# Deployed Render Backend API URL (leave empty in dev to use Vite proxy)
VITE_API_BASE_URL=

# Firebase Authentication (Frontend — safe to expose in browser)
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
